{
  "name": "sap-cap-demo",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "cds watch",
    "watch": "cds watch",
    "watch-zbooks-listreport": "cds watch --open zbookslistreport/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-zbooks-ovp": "cds watch --open zbooksovp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds": "^10.0.5",
    "express": "^4"
  },
  "devDependencies": {
    "cds-plugin-ui5": "^0.17.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/zbooks-listreport",
    "app/zbooks-ovp"
  ]
}
