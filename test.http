### 10. Test Composition (Books–Chapters)

# Tạo Book kèm Chapters (Composition → vòng đời phụ thuộc)
POST http://localhost:4004/odata/v4/catalog/$batch
Content-Type: application/json

{
  "requests": [
    { "id": "1", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 3, "title": "Refactoring: Improving Code Design", "author": "Martin Fowler", "stock": 12 } },
    { "id": "2", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 4, "title": "Building Microservices", "author": "Sam Newman", "stock": 8 } },
    { "id": "3", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 5, "title": "Designing Data-Intensive Applications", "author": "Martin Kleppmann", "stock": 15 } },
    { "id": "4", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 6, "title": "Dế Mèn Phiêu Lưu Ký", "author": "Tô Hoài", "stock": 25 } },
    { "id": "5", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 7, "title": "Mắt Biếc", "author": "Nguyễn Nhật Ánh", "stock": 30 } },
    { "id": "6", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 8, "title": "Enterprise Integration Patterns", "author": "Gregor Hohpe", "stock": 6 } },
    { "id": "7", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 9, "title": "Learning TypeScript", "author": "Josh Goldberg", "stock": 18 } },
    { "id": "8", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 10, "title": "Docker & Kubernetes Practice", "author": "Cloud Native Corp", "stock": 10 } },
    { "id": "9", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 11, "title": "Tuổi Trẻ Đáng Giá Bao Nhiêu", "author": "Rosie Nguyễn", "stock": 22 } },
    { "id": "10", "method": "POST", "url": "Books", "headers": { "content-type": "application/json" }, "body": { "ID": 12, "title": "Effective Java", "author": "Joshua Bloch", "stock": 14 } }
  ]
}

