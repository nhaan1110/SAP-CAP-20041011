<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        id="tableAuthorSelectDialog"
        title="Select Author"
        search=".onTableValueHelpSearch"
        confirm=".onTableValueHelpConfirm"
        cancel=".onTableValueHelpCancel"
        items="{path: '/Books'}">
        <StandardListItem
            title="{author}"
            description="{title}" />
    </SelectDialog>
</core:FragmentDefinition>