<mvc:View
    controllerName="zbooks_sapm.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    height="100%"
>
    <f:DynamicPage
        id="dynamicPageId"
        preserveHeaderStateOnScroll="true"
        headerExpanded="true"
        showFooter="true"
        fitContent="true"
    >
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle1">
                <f:heading>
                    <Title
                        id="_IDGenTitle"
                        text="Book Inventory Management 2"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="dynamicPageHeader">
                <f:content>
                    <fb:FilterBar
                        id="filterbar"
                        useToolbar="false"
                        search=".onSearch"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                name="title"
                                label="Book Title"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        name="title"
                                        items="{/Books}"
                                    >
                                        <core:Item
                                            key="{ID}"
                                            text="{title}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem
                                name="author"
                                label="Author"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiInput
                                        id="authorFilter"
                                        name="author"
                                        placeholder="Select Author..."
                                        showValueHelp="true"
                                        valueHelpOnly="true"
                                        valueHelpRequest=".onAuthorVHRequested"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table
                id="booksTable"
                mode="MultiSelect"
                growing="true"
                growingThreshold="20"
                items="{
        path: '/Books',
        sorter: { path: 'ID', descending: false }
    }"
            >
                <headerToolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar1">
                        <Title
                            id="_IDGenTitle2"
                            text="Book List"
                            level="H2"
                        />
                        <ToolbarSpacer id="_IDGenToolbarSpacer" />
                        <Button
                            id="btnAdd"
                            text="Add"
                            type="Emphasized"
                            icon="sap-icon://add"
                            press="onAdd"
                        />
                        <Button
                            id="btnEdit"
                            text="Edit"
                            type="Attention"
                            icon="sap-icon://edit"
                            press="onEdit"
                        />
                        <Button
                            id="btnDelete"
                            text="Delete"
                            type="Reject"
                            icon="sap-icon://delete"
                            press="onDelete"
                        />
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                
                    <Column
                        id="colID"
                        width="10%"
                    >
                        <header>
                            <Text text="ID" />
                        </header>
                    </Column>

                    <Column
                        id="colTitle"
                        width="35%"
                    >
                        <header>
                            <Text text="Book Title" />
                        </header>
                    </Column>

                    <Column
                        id="colAuthor"
                        width="30%"
                        minScreenWidth="Tablet"
                        demandPopin="true"
                    >
                        <header>
                            <Text text="Author" />
                        </header>
                    </Column>

                    <Column
                        id="colStock"
                        width="25%"
                    >
                        <header>
                            <Text text="Stock Quantity" />
                        </header>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem
                        id="_IDGenColumnListItem"
                        vAlign="Middle"
                        type="Navigation"
                        press=".onPressItem"
                    >
                        <cells>
                            <Text text="{ID}" />

                            <ObjectIdentifier title="{title}" />

                            <Input
                                value="{author}"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                valueHelpRequest=".onTableValueHelpRequest"
                            />

                            <ObjectStatus
                                text="{path: 'stock', formatter: '.formatStockText'}"
                                state="{path: 'stock', formatter: '.formatStockState'}"
                                icon="{path: 'stock', formatter: '.formatStockIcon'}"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
