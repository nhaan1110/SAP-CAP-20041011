<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog title="Edit Book" contentWidth="400px">
        <content>
            <f:SimpleForm editable="true" layout="ColumnLayout">
                <f:content>
                    <Label text="Title" required="true" />
                    <Input value="{editBook>/title}" />

                    <Label text="Author" />
                    <Input value="{editBook>/author}" />

                    <Label text="Stock" />
                    <StepInput value="{editBook>/stock}" min="0" />
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Save" type="Emphasized" press="onSaveEditDialog" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseEditDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>