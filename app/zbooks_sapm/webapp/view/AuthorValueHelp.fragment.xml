<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <SelectDialog
        id="authorValueHelpDialog"
        title="Select Author"
        search=".onValueHelpSearch"
        confirm=".onValueHelpConfirm"
        cancel=".onValueHelpClose"
        items="{path: '/Books'}">
        <StandardListItem
            title="{author}"
            description="{title}"
            type="Active" />
    </SelectDialog>
</core:FragmentDefinition>