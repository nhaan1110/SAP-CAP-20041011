<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <SelectDialog
        id="authorValueHelpDialog"
        title="Select Author"
        items="{/Books}"
        search=".onValueHelpSearch"
        confirm=".onValueHelpConfirm"
        cancel=".onValueHelpClose"
    >
        <StandardListItem
            title="{author}"
            description="{title}"
        />
    </SelectDialog>
</core:FragmentDefinition>