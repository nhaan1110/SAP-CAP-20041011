<mvc:View
    controllerName="zbooks.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    height="100%">
	
    <ObjectPageLayout
        id="ObjectPageLayout"
        showTitleInHeaderContent="true"
        upperCaseAnchorBar="false">

        <!-- 1. HEADER TITLE  -->
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>

                <expandedHeading>
                    <m:HBox alignItems="Center">
                        <m:Title text="{title}" wrapping="true" class="sapUiTinyMarginEnd"/>
                    </m:HBox>
                </expandedHeading>

                <snappedHeading>
                    <m:HBox alignItems="Center">
                        <m:Avatar src="sap-icon://education" displaySize="S" class="sapUiTinyMarginEnd"/>
                        <m:Title text="{title}" wrapping="true"/>
                    </m:HBox>
                </snappedHeading>

                <expandedContent>
                    <m:Text text="Book ID: {ID}"/>
                </expandedContent>

                <snappedContent>
                    <m:Text text="Book ID: {ID}"/>
                </snappedContent>

                <actions>
                    <m:Button text="Edit" type="Emphasized" press=".onEditPress"/>
                    <m:Button text="Delete" type="Reject" press=".onDeletePress"/>
                </actions>

            </ObjectPageDynamicHeaderTitle>
        </headerTitle>

        <!-- 2. HEADER CONTENT (ĐÃ SỬA SANG TIẾNG ANH) -->
        <headerContent>
            <m:FlexBox wrap="Wrap" fitContainer="true" alignItems="Center">

                <m:Avatar 
                    src="sap-icon://coursebook" 
                    displaySize="L" 
                    backgroundColor="Accent3" 
                    class="sapUiMediumMarginEnd"/>

                <layout:VerticalLayout>
                    <m:ObjectAttribute title="Author" text="{author}"/>
                    
                    <m:ObjectStatus 
                        title="Stock Status" 
                        text="{= ${stock} > 0 ? 'In Stock (' + ${stock} + ')' : 'Out of Stock'}" 
                        state="{= ${stock} > 10 ? 'Success' : (${stock} > 0 ? 'Warning' : 'Error')}"
                        icon="{= ${stock} > 0 ? 'sap-icon://sys-enter-2' : 'sap-icon://error'}"
                        class="sapUiTinyMarginTop"/>
                </layout:VerticalLayout>
            </m:FlexBox>
        </headerContent>

        <!-- 3. SECTIONS  -->
<sections>
    <ObjectPageSection titleUppercase="false" id="generalSection" title="General Information">
        <subSections>
            <ObjectPageSubSection id="generalSubSection">
                <blocks>
                    <form:SimpleForm 
                        editable="false" 
                        layout="ColumnLayout" 
                        columnsM="2"
                        columnsL="2"
                        columnsXL="2">
                        <form:content>
                            
                            <!-- Cột 1: Biểu tượng Sách (Xanh Dương) -->
                            <core:Title />
                            <m:ObjectStatus 
                                text="Book Details" 
                                icon="sap-icon://education" 
                                state="Information" 
                                class="sapUiTinyMarginBottom" />

                            <m:Label text="Book ID" />
                            <m:Text text="{ID}" />

                            <m:Label text="Book Title" />
                            <m:Text text="{title}" renderWhitespace="true" />

                            <!-- Cột 2: Biểu tượng Kho (Xanh Lá) -->
                            <core:Title />
                            <m:ObjectStatus 
                                text="Inventory Details" 
                                icon="sap-icon://product" 
                                state="Success" 
                                class="sapUiTinyMarginBottom" />

                            <m:Label text="Author" />
                            <m:Text text="{author}" />

                            <m:Label text="Stock Quantity" />
                            <m:Text text="{stock}" />

                        </form:content>
                    </form:SimpleForm>
                </blocks>
            </ObjectPageSubSection>
        </subSections>
    </ObjectPageSection>
</sections>
    </ObjectPageLayout>
</mvc:View>