<mvc:View
    controllerName="zbooks.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:table="sap.ui.table"
    height="100%"
>
    <f:DynamicPage
        id="dynamicPageId"
        preserveHeaderStateOnScroll="true"
        headerExpanded="true"
        showFooter="true"
        fitContent="true"
    >
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle1">
                <f:heading>
                    <Title
                        id="_IDGenTitle"
                        text="Book Inventory Management"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- DynamicPage Header -->
        <f:header>
            <f:DynamicPageHeader id="dynamicPageHeader">
                <f:content>
                    <fb:FilterBar
                        id="filterbar"
                        useToolbar="false"
                        search=".onSearch"
                    >
                        <fb:filterGroupItems>
                            <!-- Ô LỌC 1: Tên sách -->
                            <fb:FilterGroupItem
                                name="title"
                                label="Book Title"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        name="title"
                                        items="{/Books}"
                                    >
                                        <core:Item
                                            key="{ID}"
                                            text="{title}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- Ô LỌC 2: Tác giả -->
                            <fb:FilterGroupItem
                                name="author"
                                label="Author"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        name="author"
                                        items="{/Books}"
                                    >
                                        <core:Item
                                            key="{ID}"
                                            text="{author}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <!-- DynamicPage Content -->
        <f:content>
            <table:Table
                id="booksTable"
                rows="{/Books}"
                selectionMode="MultiToggle"
                visibleRowCountMode="Auto"
                rowActionCount="1"
            >
                <table:rowActionTemplate>
                    <table:RowAction id="_IDGenRowAction">
                        <table:RowActionItem
                            id="_IDGenRowActionItem"
                            type="Navigation"
                            press=".onPressItem"
                        />
                    </table:RowAction>
                </table:rowActionTemplate>

                <table:extension>
                    <OverflowToolbar id="_IDGenOverflowToolbar1">
                        <Title
                            id="_IDGenTitle2"
                            text="Book List"
                            level="H2"
                        />
                        <ToolbarSpacer id="_IDGenToolbarSpacer" />

                        <!-- Nút ADD: Hiện khi isEditing bằng false -->
                        <Button
                            id="btnAdd"
                            text="Add"
                            type="Emphasized"
                            icon="sap-icon://add"
                            press="onAdd"
                            visible="{= ${ui>/isEditing} === false }"
                        />

                        <!-- Nút EDIT: Hiện khi isEditing bằng false -->
                        <Button
                            id="btnEdit"
                            text="Edit"
                            type="Attention"
                            icon="sap-icon://edit"
                            press="onEdit"
                            visible="{= ${ui>/isEditing} === false }"
                        />

                        <!-- Nút DELETE: Hiện khi isEditing bằng false -->
                        <Button
                            id="btnDelete"
                            text="Delete"
                            type="Reject"
                            icon="sap-icon://delete"
                            press="onDelete"
                            visible="{= ${ui>/isEditing} === false }"
                        />

                        <Button
                            text="Refresh"
                            icon="sap-icon://refresh"
                            press="onRefresh"
                        />

                        <Button
                            id="btnSave"
                            text="Save"
                            type="Accept"
                            icon="sap-icon://save"
                            press="onSave"
                            visible="{= ${ui>/isEditing} === true }"
                        />

                        <Button
                            id="btnCancel"
                            text="Cancel"
                            type="Default"
                            icon="sap-icon://cancel"
                            press="onCancel"
                            visible="{= ${ui>/isEditing} === true }"
                        />
                    </OverflowToolbar>
                </table:extension>

                <table:columns>
                    <!--- Book ID -->
                    <table:Column
                        id="_IDGenColumn"
                        width="10rem"
                    >
                        <Label text="Book ID (ID)" />
                        <table:template>
                            <Text
                                id="_IDGenText4"
                                text="{ID}"
                            />
                        </table:template>
                    </table:Column>

                    <!--  Book Title -->
                    <table:Column id="_IDGenColumn1">
                        <Label text="Book Title" />
                        <table:template>
                            <Text
                                id="_IDGenText5"
                                text="{title}"
                            />
                        </table:template>
                    </table:Column>

                    <!--- Author -->
                    <table:Column id="_IDGenColumn2">
                        <Label text="Author" />
                        <table:template>
                            <Input
                                id="_IDGenInput"
                                value="{path: 'author', mode: 'TwoWay'}"
                                editable="{ui>/isEditing}"
                                showValueHelp="true"
                                valueHelpRequest="onValueHelpRequest"
                                placeholder="Select Author"
                            />
                        </table:template>
                    </table:Column>

                    <!-- Stock Quantity -->
                    <table:Column id="_IDGenColumn3">
                        <Label text="Stock Quantity" />
                        <table:template>
                            <VBox>
                                <!-- 1. Hiển thị trạng thái (ObjectStatus) khi KHÔNG ở chế độ Edit -->
                                <ObjectStatus
                                    id="_IDGenStockStatus"
                                    text="{path: 'stock', formatter: '.formatStockText'}"
                                    state="{path: 'stock', formatter: '.formatStockState'}"
                                    icon="{path: 'stock', formatter: '.formatStockIcon'}"
                                    visible="{path: 'ui>/isEditing', formatter: '.formatNotEditing'}"
                                />

                                <!-- 2. Hiển thị ô nhập liệu (Input) khi ĐANG ở chế độ Edit -->
                                <Input
                                    value="{path: 'stock', mode: 'TwoWay'}"
                                    type="Number"
                                    editable="{ui>/isEditing}"
                                    visible="{path: 'ui>/isEditing', formatter: '.formatIsEditing'}"
                                    placeholder="Enter stock"
                                />
                            </VBox>
                        </table:template>
                    </table:Column>
                </table:columns>
            </table:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
