<mvc:View
    xmlns:c="sap.ui.core"
    controllerName="zbooks.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:layout="sap.ui.layout"
    height="100%">
    
    <f:DynamicPage id="dynamicPageId" preserveHeaderStateOnScroll="true" headerExpanded="true" showFooter="true" fitContent="true">
        
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle id="_IDGenDynamicPageTitle1">
                <f:heading>
                    <Title id="_IDGenTitle" text="Header Title"/>
                </f:heading>
                <f:expandedContent>
                    <Label id="_IDGenLabel" text="This is a subheading"/>
                </f:expandedContent>
                <f:snappedContent>
                    <Label id="_IDGenLabel1" text="This is a subheading"/>
                </f:snappedContent>
                <f:snappedTitleOnMobile>
                    <Title id="_IDGenTitle1" text="This is a subheading"/>
                </f:snappedTitleOnMobile>
                <f:content>
                    <OverflowToolbar id="_IDGenOverflowToolbar">
                        <GenericTag id="_IDGenGenericTag" text="SR"
                            status="Error"
                            design="StatusIconHidden">
                            <ObjectNumber id="_IDGenObjectNumber" number="2"
                                unit="M"
                                emphasized="false"
                                state="Error"/>
                        </GenericTag>
                    </OverflowToolbar>
                </f:content>
                <f:actions>
                    <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                    <Button id="_IDGenButton" text="Edit" type="Emphasized"/>
                    <Button id="_IDGenButton1" text="Delete" type="Transparent"/>
                    <Button id="_IDGenButton2" text="Copy" type="Transparent"/>
                    <Button id="_IDGenButton3" icon="sap-icon://action" type="Transparent"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- DynamicPage Header -->
        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader" pinnable="true">
                <FlexBox id="_IDGenFlexBox" alignItems="Start" justifyContent="SpaceBetween">
                    <items>
                        <Panel id="_IDGenPanel" backgroundDesign="Transparent" class="sapUiNoContentPadding">
                            <content>
                                <layout:HorizontalLayout id="_IDGenHorizontalLayout" allowWrapping="true">
                                    <layout:VerticalLayout id="_IDGenVerticalLayout" class="sapUiMediumMarginEnd">
                                        <ObjectAttribute id="_IDGenObjectAttribute" title="Location" text="Warehouse A"/>
                                        <ObjectAttribute id="_IDGenObjectAttribute1" title="Halway" text="23L"/>
                                        <ObjectAttribute id="_IDGenObjectAttribute2" title="Rack" text="34"/>
                                    </layout:VerticalLayout>
                                    <layout:VerticalLayout id="_IDGenVerticalLayout1">
                                        <ObjectAttribute id="_IDGenObjectAttribute3" title="Availability"/>
                                        <ObjectStatus id="_IDGenObjectStatus" text="In Stock" state="Success" />
                                    </layout:VerticalLayout>
                                </layout:HorizontalLayout>
                            </content>
                        </Panel>
                    </items>
                </FlexBox>
            </f:DynamicPageHeader>
        </f:header>

        <!-- DynamicPage Content -->
        <f:content>
            <Table id="booksTable" items="{/Books}" mode="SingleSelect">
                <headerToolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar1">
                        <Title id="_IDGenTitle2" text="Book List" level="H2"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column id="_IDGenColumn"><Text id="_IDGenText" text="Book ID (ID)" /></Column>
                    <Column id="_IDGenColumn1"><Text id="_IDGenText1" text="Book Title" /></Column>
                    <Column id="_IDGenColumn2"><Text id="_IDGenText2" text="Author" /></Column>
                    <Column id="_IDGenColumn3"><Text id="_IDGenText3" text="Stock Quantity" /></Column>
                </columns>
                <items>
                    <ColumnListItem id="_IDGenColumnListItem">
                        <cells>
                            <Text id="_IDGenText4" text="{ID}" />
                            <Text id="_IDGenText5" text="{title}" />
                            <Input id="_IDGenInput"
                                value="{author}"
                                showValueHelp="true"
                                valueHelpRequest="onValueHelpRequest"
                                placeholder="Select Author" />
                            <Text id="_IDGenText6" text="{stock}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>

        <!-- DynamicPage Footer -->
        <f:footer>
            <OverflowToolbar id="_IDGenOverflowToolbar2">
                <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
                <Button id="_IDGenButton4" type="Accept" text="Accept"/>
                <Button id="_IDGenButton5" type="Reject" text="Reject"/>
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
