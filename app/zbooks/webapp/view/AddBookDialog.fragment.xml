<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    
    <Dialog id="addBookDialog" title="Add New Book" contentWidth="400px">
        <f:SimpleForm editable="true" layout="ColumnLayout">
            <Label text="Book Title" required="true"/>
            <Input value="{newBook>/title}" placeholder="Enter book title..."/>
            
            <Label text="Author"/>
            <Input value="{newBook>/author}" placeholder="Enter author name..."/>
            
            <Label text="Stock Quantity"/>
            <Input value="{newBook>/stock}" type="Number"/>
        </f:SimpleForm>
        
        <beginButton>
            <Button text="Save" type="Emphasized" press="onSaveBook"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press="onCloseAddDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>